# Model Layer Services - Environment Configuration
# Copy this file to .env and update with your settings

# LLM Inference Service (Port 5005)
LLM_PORT=5005
LLM_HOST=127.0.0.1
LLM_MODEL_PATH=
LLM_MODEL_NAME=llama-2-7b-chat
LLM_BACKEND=mock
LLM_GPU_ENABLED=false
LLM_MAX_CONCURRENT=2
LLM_TIMEOUT=60
LLM_AUTH_TOKEN=

# Embedding Service (Port 8100)
EMBED_PORT=8100
EMBED_HOST=127.0.0.1
EMBED_MODEL_NAME=all-MiniLM-L6-v2
EMBED_GPU_ENABLED=false
EMBED_DEVICE=auto
EMBED_MAX_CONCURRENT=10
EMBED_AUTH_TOKEN=

# OCR Service (Port 8200)
OCR_PORT=8200
OCR_HOST=127.0.0.1
OCR_BACKEND=easyocr
OCR_GPU_ENABLED=false
OCR_MAX_CONCURRENT=3
OCR_ENABLE_TABLES=true
OCR_MASK_PII=false
OCR_UPLOAD_DIR=./data/uploads
OCR_AUTH_TOKEN=



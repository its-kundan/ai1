# Database Configuration
# PostgreSQL connection string with pgvector support
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/backend2?schema=public"

# Server Configuration
PORT=8001
HOST=0.0.0.0
NODE_ENV=development

# CORS Configuration
# Comma-separated list of allowed origins
CORS_ORIGIN="http://localhost:3000,http://127.0.0.1:3000"

# File Upload Configuration
MAX_FILE_SIZE_MB=50
UPLOAD_DIR="./data/uploads"
OCR_RESULTS_DIR="./data/ocr_results"

# External Service URLs
# Python OCR microservice (preferred)
OCR_SERVICE_URL="http://localhost:8100/api/v1/ocr"

# Python embedding service (preferred)
EMBEDDING_SERVICE_URL="http://localhost:8100/api/v1/embed"

# Local LLM service (e.g., text-generation-webui)
LLM_SERVICE_URL="http://localhost:5005/infer"
LLM_TIMEOUT_MS=30000
LLM_MAX_TOKENS=512

# Optional: LLM subprocess mode (if using llama.cpp directly)
# LLAMA_CPP_PATH="./llama.cpp/main"
# LLM_MODEL_PATH="./models/llama.gguf"

# Logging
LOG_LEVEL="info"

# Redis (optional, for BullMQ background jobs)
# REDIS_URL="redis://localhost:6379"

# Test Configuration (for running tests)
# TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/backend2_test?schema=public"
